#!/usr/bin/env bash
# Claude Code PreToolUse hook (matcher: Bash). Blocks `git commit` / `git push`
# when the outgoing diff contains something that looks like an API key, or
# stages a .env file. Exit 2 = block (message goes back to the assistant);
# exit 0 = allow. Anything that isn't a commit/push is allowed immediately.
# Seeded by Opportunity Hack ({{EVENT_ID}}). Keep it after the event too.

input=$(cat)
if command -v python3 >/dev/null 2>&1; then
  cmd=$(printf '%s' "$input" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("tool_input", {}).get("command", ""))
except Exception:
    print("")' 2>/dev/null)
else
  cmd=$(printf '%s' "$input" | sed -n 's/.*"command"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/p' | head -1)
fi

case "$cmd" in
  *"git commit"*|*"git push"*) ;;
  *) exit 0 ;;
esac

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

if [[ "$cmd" == *"git push"* ]]; then
  diff=$(git diff -U0 '@{upstream}...HEAD' 2>/dev/null || git show -U0 --format= HEAD 2>/dev/null)
  files=$(git diff --name-only '@{upstream}...HEAD' 2>/dev/null || git show --name-only --format= HEAD 2>/dev/null)
else
  diff=$(git diff --cached -U0 2>/dev/null)
  files=$(git diff --cached --name-only 2>/dev/null)
fi

# Added lines only, so removing a leaked key is never blocked.
added=$(printf '%s\n' "$diff" | grep '^+' | grep -v '^+++' || true)

pattern='sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|xox[abprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits=$(printf '%s\n' "$added" | grep -E -o "$pattern" | head -5 || true)
envfiles=$(printf '%s\n' "$files" | grep -E '(^|/)\.env(\.[A-Za-z0-9_-]+)?$' | grep -v '\.env\.example$' || true)

if [ -n "$hits" ] || [ -n "$envfiles" ]; then
  {
    echo "BLOCKED: this would publish a secret."
    [ -n "$hits" ] && echo "Looks like a key: $(printf '%s' "$hits" | sed -E 's/(.{8}).*/\1…/' | tr '\n' ' ')"
    [ -n "$envfiles" ] && echo "Env file(s) staged: $(printf '%s' "$envfiles" | tr '\n' ' ')"
    echo "Move the value into .env (gitignored), reference it via an environment variable, keep placeholders in .env.example, then retry."
    echo "If a real key was already pushed, rotate it now — for the OHack AI gateway key, ask an organizer for a new card."
  } >&2
  exit 2
fi
exit 0
